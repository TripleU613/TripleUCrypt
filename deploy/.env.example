# Copy to deploy/.env and fill in. (deploy/.env is git-ignored — never commit it.)

# Cloudflare Tunnel token:
#   Cloudflare Zero Trust → Networks → Tunnels → (your tunnel) → copy the token
#   (the long string after `--token` in the install command).
TUNNEL_TOKEN=paste-your-tunnel-token-here

# ── Live trading creds (optional) ────────────────────────────────────────────
# They do NOT go in this file — put them in deploy/secrets.env (git-ignored,
# already wired into docker-compose.yml with required:false). Only two are
# required; everything else in the repo-root .env.example is optional:
#
#   POLY_PRIVATE_KEY=0x...       # signer key (KEEP SECRET)
#   POLY_WALLET_ADDRESS=0x...    # Polymarket proxy/funder wallet
#
# Without secrets.env the app runs in practice mode.
